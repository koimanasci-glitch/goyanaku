# Disalin otomatis ke deploy/docker/.env oleh setup.sh (password & kunci dibuat acak).
# JANGAN masukkan file .env ke GitHub.

DOMAIN=app.goyana.id
APP_URL=https://app.goyana.id
APP_NAME=Goyana
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=id
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_DATABASE=goyana
DB_USERNAME=goyana
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

GOYANA_ADMIN_MFA=true
GOYANA_FULL_ACCESS_EMAILS=koimanasci@gmail.com
GOYANA_GOOGLE_CLIENT_IDS=
GOYANA_WHATSAPP_ENABLED=false

# Email (verifikasi, reset password, pesan otomatis). Isi SMTP sungguhan lalu jalankan update.sh.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@goyana.id
MAIL_FROM_NAME=GOYANA
GOYANA_REQUIRE_EMAIL_VERIFICATION=false
