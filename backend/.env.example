APP_NAME=Goyana
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=Goyana

# Masuk dengan Google (pemilik). Client ID OAuth dari Google Cloud Console, dipisah koma bila lebih dari satu. Kosong = dimatikan.
GOYANA_GOOGLE_CLIENT_IDS=
# Email pemilik yang usahanya selalu berpaket tertinggi (akun uji pemilik GOYANA), dipisah koma. Diisi di server saja.
GOYANA_FULL_ACCESS_EMAILS=

# Gateway WhatsApp untuk blast marketing (none = belum tersambung). Token hanya di server.
GOYANA_WA_DRIVER=none
GOYANA_WA_URL=
GOYANA_WA_TOKEN=
GOYANA_WA_WEBHOOK_TOKEN=
